# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.ipynb_checkpoints/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build and packaging artifacts
build/
dist/
wheels/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Local environment and tool configuration
.env
.env.*
!.env.example
.python-version
.cache/

# Local runtime databases
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Local agent state
.agents/
.codex/

# Large datasets and generated pipeline outputs
/data/**/*
!/data/**/
!/data/**/readme.txt
!/data/README.txt
/data/runtime/tasks/*/
/data_example/

# Local model weights and training checkpoints; keep only structure metadata.
/models/**/*
!/models/**/
!/models/**/readme.txt
!/models/README.md
!/models/production/active.json
!/models/production/*/manifest.json
!/models/production/*/feature_schema.json
!/models/production/*/label_mapping.json
/hf_cache/
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.onnx
*.h5
*.ot
*.pkl
*.pickle
*.npy
*.npz
*.parquet
*.feather

# Packet captures
*.pcap
*.pcapng

# Experiment trackers and logs
/runs/
/wandb/
/mlruns/
/outputs/
/logs/
*.log

# Generated legacy experiment figures/data
/legacy/models/
/legacy/data/workspace_pre_strict_parser/**/*
!/legacy/data/workspace_pre_strict_parser/
!/legacy/data/workspace_pre_strict_parser/README.md
/legacy/**/*.png
/legacy/**/*.jpg
/legacy/**/*.jpeg
/legacy/**/*.svg
/legacy/**/*.csv
/legacy/**/*.tsv
/legacy/**/*.jsonl

# Generated reports/assets stay local; Markdown project documentation is tracked.
/docs/*
!/docs/*.md

# Binary reports and office temporary files
*.pdf
*.docx
*.pptx
*.xlsx
~$*

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo

# Project-local scratch directory
/damn/
